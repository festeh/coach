#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
build_root="$project_root/build"
stage="$build_root/stage"
revision="$(git -C "$project_root" rev-parse HEAD)"

rm -rf "$build_root"
install -d -m 0755 "$stage/bin"

(
  cd "$project_root/admin"
  npm ci
  npm run check
  npm run build
  npm audit --audit-level=low
)

(
  cd "$project_root"
  go test ./...
  CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags='-s -w' -o "$stage/bin/coach" ./cmd/coach
)

chmod 0755 "$stage/bin/coach"
printf '%s\n' "$revision" > "$stage/REVISION"
chmod 0644 "$stage/REVISION"

tar \
  --sort=name \
  --mtime='UTC 1970-01-01' \
  --owner=0 \
  --group=0 \
  --numeric-owner \
  -C "$stage" \
  -czf "$build_root/coach.tar.gz" \
  REVISION bin

sha256sum "$build_root/coach.tar.gz" | awk '{ print $1 }' > "$build_root/coach.sha256"
